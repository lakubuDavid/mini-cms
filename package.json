{
  "name": "start-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:cli": "bun --cwd=packages/cli run build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "test": "turbo test",
    "test:e2e": "bun --cwd apps/web run test:e2e",
    "typecheck": "turbo typecheck",
    "deploy": "vercel deploy --prod",
    "deploy:preview": "vercel deploy",
    "deploy:tool": "bun --cwd=packages/cli run deploy-tool"
  },
  "devDependencies": {
    "oxfmt": "^0.36.0",
    "rolldown-vite": "^7.3.1",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20"
  }
}
