{
  "name": "@lakubudavid/mini-cli",
  "version": "0.1.0",
  "description": "CLI for Mini CMS — sync schemas, manage collections, generate client files",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mini-cms": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "build:compile": "bun build --compile dist --outfile dist/mini-cms",
    "build:all": "bun run build && bun run build:compile",
    "lint": "oxlint src",
    "test": "bun test tests/unit",
    "typecheck": "tsc --noEmit",
    "start": "bun ./src/index.ts",
    "deploy-tool": "bun run build:compile && cp ./dist/mini-cms ~/tools",
    "publish:jsr": "bun run build && npx jsr publish"
  },
  "dependencies": {
    "citty": "^0.2.1",
    "cli-table3": "^0.6.5",
    "cmd-table": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.5.0",
    "oxlint": "^1.55.0",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}
