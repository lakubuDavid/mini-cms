{
  "name": "@workspace/cli",
  "version": "0.0.0",
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.1.0",
    "citty": "^0.2.1",
    "oxlint": "^1.51.0",
    "tsdown": "^0.15.1",
    "typescript": "^5.9.3"
  },
  "bin": {
    "mini-cms": "./dist/index.js"
  },
  "private": true,
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts && bun build --compile dist --outfile dist/mini-cms",
    "lint": "oxlint src",
    "test": "bun test tests/unit",
    "typecheck": "tsc --noEmit",
    "start": "bun ./src/index.ts",
    "deploy-tool": "cp ./dist/mini-cms ~/tools"
  },
  "type": "module"
}
